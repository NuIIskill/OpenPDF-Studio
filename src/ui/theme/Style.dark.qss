/* ============================================================
   OpenPDF Studio — Dark Mode Stylesheet
   Base: #353535 mid-gray
   ============================================================ */

/* ── Window & base ───────────────────────────────────────── */
QMainWindow {
    background-color: #2B2B2B;
}

QSplitter {
    background: #2B2B2B;
}

QSplitter::handle {
    background: #484848;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── TopToolbar ──────────────────────────────────────────── */
#TopToolbar {
    background-color: #353535;
    border-bottom: 1px solid #484848;
}

#TabBarInner {
    background: transparent;
}

#AppLogo {
    background-color: #2563EB;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 800;
}

#AppNameLabel {
    color: #D8D8D8;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.2px;
}

#DocTab {
    background-color: #404040;
    border: 1px solid #505050;
    border-radius: 6px;
}

#DocTab:checked {
    background-color: #4A4A4A;
    border-color: #606060;
}

#DocTabLabel {
    color: #C8C8C8;
    font-size: 13px;
    font-weight: 500;
}

#NewTabBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#NewTabBtn:hover {
    background: #404040;
}

#ZoomLabel {
    color: #D8D8D8;
    font-size: 13px;
    font-weight: 500;
    min-width: 44px;
    qproperty-alignment: AlignCenter;
}

/* ── IconButton ──────────────────────────────────────────── */
#IconButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0px;
}

#IconButton:hover {
    background-color: #484848;
}

#IconButton:pressed {
    background-color: #555555;
}

#IconButton:checked {
    background-color: #4A4A4A;
}

#IconButton:disabled {
    opacity: 0.4;
}

/* ── LeftSidebar ─────────────────────────────────────────── */
#LeftSidebar {
    background-color: #353535;
    border-right: 1px solid #484848;
}

#LeftSidebar #IconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
}

#LeftSidebar #IconButton:hover {
    background-color: #484848;
}

#LeftSidebar #IconButton:pressed {
    background-color: #555555;
}

#LeftSidebar #IconButton:checked {
    background-color: #4A4A4A;
}

/* ── Customize Tools card ────────────────────────────────── */
QFrame#ToolCustomizeCard {
    background: #404040;
    border: 1px solid #545454;
    border-radius: 12px;
}
QLabel#ToolCustomizeTitle {
    font-size: 14px;
    font-weight: 700;
    color: #E5E5E5;
}
QLabel#ToolCustomizeHint {
    font-size: 12px;
    color: #9CA3AF;
    padding-top: 2px;
}
QPushButton#ToolCustomizeClose {
    border: none;
    background: transparent;
    border-radius: 5px;
}
QPushButton#ToolCustomizeClose:hover { background: #4A4A4A; }
QListWidget#ToolCustomizeList {
    background: transparent;
    border: none;
    outline: none;
}
QPushButton#ToolCustomizeReset {
    border: none;
    background: transparent;
    color: #60A5FA;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 2px;
    text-align: left;
}
QPushButton#ToolCustomizeReset:hover { color: #93C5FD; }

/* ── DocumentView canvas ─────────────────────────────────── */
#DocumentView {
    background-color: #2B2B2B;
    border: none;
}

#DocumentCanvas {
    background-color: #2B2B2B;
}

#DocumentView QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 3px;
    min-height: 32px;
}

#DocumentView QScrollBar::handle:vertical:hover {
    background: #666666;
}

#DocumentView QScrollBar::add-line:vertical,
#DocumentView QScrollBar::sub-line:vertical { height: 0px; }

#DocumentView QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:horizontal {
    background: #555555;
    border-radius: 3px;
    min-width: 32px;
}

#DocumentView QScrollBar::handle:horizontal:hover {
    background: #666666;
}

#DocumentView QScrollBar::add-line:horizontal,
#DocumentView QScrollBar::sub-line:horizontal { width: 0px; }

/* ── PDF page labels — always white paper ────────────────── */
QLabel#PageLabel {
    background: #FFFFFF;
    border: 1px solid #D0D0D0;
}

/* ── DropHint ─────────────────────────────────────────────── */
#DropHint {
    color: #888888;
    font-size: 14px;
}

/* ── Image region overlay ────────────────────────────────── */
QFrame#ImageRegionOverlay {
    border: 2px dashed #3B82F6;
    background: rgba(59, 130, 246, 20);
    border-radius: 3px;
}

/* ── Grid view ───────────────────────────────────────────── */
#GridCanvas {
    background: #2B2B2B;
}

QFrame#GridCard {
    background: #3A3A3A;
    border: 1px solid #484848;
    border-radius: 8px;
}

QFrame#GridCard:hover {
    border-color: #606060;
    background: #404040;
}

QLabel#GridPageLabel {
    font-size: 12px;
    font-weight: 500;
    color: #9CA3AF;
}

/* ── RightSidebar ────────────────────────────────────────── */
#RightSidebar {
    background-color: #353535;
    border-left: 1px solid #484848;
}

#ModeButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    text-align: center;
}

#ModeButton:hover {
    background-color: #484848;
}

#ModeButtonSelected {
    background-color: #404040;
    border: 1px solid #555555;
    border-radius: 10px;
    text-align: center;
}

#ModeLabel {
    font-size: 11px;
    font-weight: 500;
    color: #888888;
}

#ModeLabelSelected {
    font-size: 11px;
    font-weight: 500;
    color: #C8C8C8;
}

/* ── StatusBar ───────────────────────────────────────────── */
#StatusBar {
    background-color: #353535;
    border-top: 1px solid #484848;
}

#PageInput {
    background: #404040;
    border: 1px solid #555555;
    border-radius: 5px;
    color: #D8D8D8;
    font-size: 13px;
    font-weight: 500;
    padding: 2px 4px;
    selection-background-color: #555555;
}

#PageInput:focus {
    border-color: #7070A0;
    outline: none;
}

#PageTotalLabel {
    color: #888888;
    font-size: 13px;
}

/* ── Generic QLabel ──────────────────────────────────────── */
QLabel {
    color: #D8D8D8;
}

/* ── Generic QPushButton fallback ────────────────────────── */
QPushButton {
    background-color: #555555;
    color: #E8E8E8;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 16px;
}

QPushButton:hover   { background-color: #626262; }
QPushButton:pressed { background-color: #484848; }
QPushButton:disabled { background-color: #404040; color: #777777; }

/* ── ToolbarSeparator ────────────────────────────────────── */
#ToolbarSeparator {
    background: #484848;
}

/* ── ScrollArea viewport ─────────────────────────────────── */
QScrollArea > QWidget > QWidget { background: transparent; }

/* ── SettingsPanel ───────────────────────────────────────── */
QDialog#SettingsPanel {
    background: #353535;
}

QWidget#SettingsSidebar {
    background: #2E2E2E;
    border-right: 1px solid #484848;
}

QStackedWidget#SettingsPages,
QScrollArea#SettingsScroll,
QWidget#SettingsScrollContent,
QWidget#SettingsAboutPage {
    background: #353535;
    border: none;
}

/* Override the global "transparent" scroll viewport rule */
QScrollArea#SettingsScroll > QWidget > QWidget {
    background: #353535;
}

QLabel#SettingsSectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #E5E5E5;
}

QLabel#SettingsSectionDesc {
    font-size: 12px;
    color: #9CA3AF;
}

QLabel#SettingsGroupLabel {
    font-size: 11px;
    font-weight: 700;
    color: #9CA3AF;
}

QFrame#SettingsSeparator {
    color: #484848;
    background: #484848;
    border: none;
    max-height: 1px;
}

QComboBox#SettingsLangCombo {
    background: #404040;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #D8D8D8;
}
QComboBox#SettingsLangCombo::drop-down { border: none; width: 20px; }
QComboBox#SettingsLangCombo QAbstractItemView {
    background: #404040;
    border: 1px solid #555555;
    color: #D8D8D8;
}

QPushButton#SettingsSaveBtn {
    background: #2563EB;
    color: white;
}
QPushButton#SettingsSaveBtn:hover { background: #1D4ED8; }

QPushButton#SettingsResetBtn {
    background: transparent;
    color: #C8C8C8;
    border: 1px solid #555555;
    border-radius: 8px;
}
QPushButton#SettingsResetBtn:hover { background: #484848; }

QPushButton#SettingsCancelBtn {
    background: #404040;
    color: #D8D8D8;
    border: 1px solid #555555;
    border-radius: 8px;
}
QPushButton#SettingsCancelBtn:hover { background: #484848; }

/* ── Keyboard Shortcuts page ─────────────────────────────── */
QLineEdit#ShortcutSearch {
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 4px 10px;
    background: #404040;
    color: #D8D8D8;
    font-size: 13px;
}

QWidget#ShortcutTableHeader {
    background: #2E2E2E;
}

QLabel#ShortcutColHeader {
    font-size: 11px;
    font-weight: 600;
    color: #9CA3AF;
}

QLabel#ShortcutDisplay {
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 2px 12px;
    background: #2E2E2E;
    font-size: 13px;
    color: #C8C8C8;
}

QLineEdit#ShortcutCapture {
    border: 2px solid #3B82F6;
    border-radius: 6px;
    padding: 2px 10px;
    background: #404040;
    font-size: 13px;
    color: #E5E5E5;
}

QPushButton#ShortcutResetBtn {
    border: 1px solid #555555;
    border-radius: 6px;
    background: transparent;
    color: #9CA3AF;
    font-size: 15px;
}
QPushButton#ShortcutResetBtn:hover { background: #484848; color: #D8D8D8; }

QPushButton#ShortcutEditBtn {
    border: 1px solid #555555;
    border-radius: 6px;
    background: #404040;
    color: #D8D8D8;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#ShortcutEditBtn:hover { background: #484848; }

QPushButton#ShortcutSaveBtn {
    border: none;
    border-radius: 6px;
    background: #2563EB;
    color: white;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#ShortcutSaveBtn:hover { background: #1D4ED8; }

QPushButton#ShortcutCancelBtn {
    border: 1px solid #555555;
    border-radius: 6px;
    background: #404040;
    color: #D8D8D8;
    font-size: 12px;
}
QPushButton#ShortcutCancelBtn:hover { background: #484848; }

QPushButton#ShortcutClearBtn {
    border: 1px solid #555555;
    border-radius: 4px;
    background: transparent;
    color: #9CA3AF;
    font-size: 11px;
}
QPushButton#ShortcutClearBtn:hover { background: #4D2020; color: #F87171; border-color: #7F1D1D; }

QFrame#ShortcutInfoBar {
    background: #1E3358;
    border-top: 1px solid #2D4A7A;
}
QLabel#ShortcutInfoIcon { color: #60A5FA; font-size: 14px; font-weight: 700; }
QLabel#ShortcutInfoText { color: #93C5FD; font-size: 12px; }

QPushButton#SettingsActionBtn {
    border: 1px solid #555555;
    border-radius: 6px;
    background: #404040;
    color: #D8D8D8;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 14px;
}
QPushButton#SettingsActionBtn:hover { background: #484848; }
QPushButton#SettingsActionBtn:disabled { color: #7A7A7A; background: #3A3A3A; }

/* ── Zoom settings page ───────────────────────────────────── */
QFrame#ZoomCard,
QFrame#SettingsCard {
    border: 1px solid #484848;
    border-radius: 10px;
    background: #404040;
}
QLabel#ZoomCardTitle,
QLabel#SettingsCardTitle {
    font-size: 13px;
    font-weight: 700;
    color: #E5E5E5;
}
QLabel#ZoomRowLabel,
QLabel#SettingsRowLabel {
    font-size: 13px;
    color: #D8D8D8;
}
QLabel#ZoomRowDesc,
QLabel#SettingsRowDesc {
    font-size: 12px;
    color: #9CA3AF;
}
QFrame#ZoomExampleBox {
    background: #1E3358;
    border: 1px solid #2D4A7A;
    border-radius: 6px;
}
QLabel#ZoomExampleIcon { color: #60A5FA; font-size: 14px; }
QLabel#ZoomExampleText { font-size: 12px; color: #93C5FD; }
QSpinBox#ZoomStepSpin {
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 4px 8px;
    background: #2E2E2E;
    font-size: 13px;
    color: #D8D8D8;
}
QSpinBox#ZoomStepSpin::up-button, QSpinBox#ZoomStepSpin::down-button {
    width: 20px;
    border: none;
}
QComboBox#ZoomActionCombo,
QComboBox#AdvancedCombo,
QComboBox#UsageCombo {
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 6px 10px;
    background: #2E2E2E;
    font-size: 13px;
    color: #D8D8D8;
    min-width: 120px;
}
QComboBox#ZoomActionCombo::drop-down,
QComboBox#AdvancedCombo::drop-down,
QComboBox#UsageCombo::drop-down { border: none; width: 20px; }
QComboBox#AdvancedCombo:disabled {
    color: #6B7280;
    background: #3A3A3A;
    border-color: #4A4A4A;
}
QFrame#TextPanel, QWidget#TextPanelContent, QScrollArea#TextPanelScroll { background:#353535; border:none; }
QFrame#TextPanel { border-left:1px solid #484848; }
QLabel#TextPanelTitle { color:#D8D8D8; font-size:16px; font-weight:700; padding-bottom:5px; }
QLabel#TextPanelHint { color:#9CA3AF; font-size:12px; padding:6px 0 10px 0; }
QLabel[textSection="true"] { color:#E5E5E5; font-size:12px; font-weight:700; }
QFrame#TextPanelDivider { color:#484848; background:#484848; min-height:1px; max-height:1px; border:none; }
QPushButton#TextPanelClose { border:none; background:transparent; color:#A0A0A0; font-size:18px; }
QPushButton#TextPanelClose:hover { color:#E5E5E5; background:#404040; border-radius:5px; }
QFrame#TextPanel QLabel { color:#D8D8D8; font-size:12px; }
QFrame#TextPanel QComboBox, QFrame#TextPanel QDoubleSpinBox { background:#2E2E2E; color:#D8D8D8; border:1px solid #555555; border-radius:5px; min-height:28px; padding:0 8px; }
QFrame#TextPanel QComboBox:focus, QFrame#TextPanel QDoubleSpinBox:focus { border:1px solid #60A5FA; }
QFrame#TextPanel QComboBox:hover, QFrame#TextPanel QDoubleSpinBox:hover { border-color:#6B7280; }
QFrame#TextPanel QComboBox:disabled, QFrame#TextPanel QDoubleSpinBox:disabled { background:#3A3A3A; color:#777777; border-color:#4A4A4A; }
QFrame#TextPanel QComboBox::drop-down { border:none; width:24px; }
QPushButton[switch="true"] { background:#666666; color:#FFFFFF; border:none; border-radius:10px; padding:0 3px; text-align:left; }
QPushButton[switch="true"]:checked { background:#3B82F6; text-align:right; }
QPushButton#TextPanelSaveDefault { color:#93C5FD; background:#404040; border:1px solid #555555; border-radius:5px; font-weight:600; }
QPushButton#TextPanelSaveDefault:hover { background:#484848; border-color:#60A5FA; }
QFrame#TextPanel QSlider::groove:horizontal { height:3px; background:#555555; border-radius:1px; }
QFrame#TextPanel QSlider::sub-page:horizontal { background:#3B82F6; }
QFrame#TextPanel QSlider::handle:horizontal { background:#60A5FA; width:14px; height:14px; margin:-6px 0; border-radius:7px; }

/* ── Text FormatBar ─────────────────────────────────────── */
QFrame#FormatBar { background:#353535; border-bottom:1px solid #484848; }
QFrame#FormatBar QLabel[formatLabel="true"] { color:#9CA3AF; font-size:9px; font-weight:600; padding-bottom:1px; }
QFrame#FormatBar QFrame#FormatBarSeparator { background:#555555; border:none; }
QFrame#FormatBar QComboBox#FormatBarCombo,
QFrame#FormatBar QFontComboBox#FormatBarCombo {
    background:#2E2E2E; color:#D8D8D8; border:1px solid #555555;
    border-radius:6px; padding-left:8px;
}
QFrame#FormatBar QComboBox#FormatBarCombo:hover,
QFrame#FormatBar QFontComboBox#FormatBarCombo:hover { border-color:#707070; }
QFrame#FormatBar QComboBox#FormatBarCombo:focus,
QFrame#FormatBar QFontComboBox#FormatBarCombo:focus { border-color:#60A5FA; }
QFrame#FormatBar QComboBox#FormatBarCombo::drop-down,
QFrame#FormatBar QFontComboBox#FormatBarCombo::drop-down { border-left:1px solid #555555; width:24px; }
QFrame#FormatBar QComboBox#FormatBarCombo::down-arrow,
QFrame#FormatBar QFontComboBox#FormatBarCombo::down-arrow { image:url(:/icons/chevron-down.svg); width:11px; height:11px; }
QFrame#FormatBar QComboBox#FormatBarCombo QLineEdit { background:#2E2E2E; color:#D8D8D8; border:none; }
QFrame#FormatBar QComboBox#FormatBarCombo QAbstractItemView,
QFrame#FormatBar QFontComboBox#FormatBarCombo QAbstractItemView { background:#404040; color:#D8D8D8; selection-background-color:#2563EB; }
QFrame#FormatBar QPushButton[formatButton="true"] {
    background:#404040; color:#D8D8D8; border:1px solid #555555; border-radius:5px;
}
QFrame#FormatBar QPushButton[alignButton="true"] { background:transparent; border:none; border-radius:5px; }
QFrame#FormatBar QPushButton[menuButton="true"] { background:#404040; color:#D8D8D8; border:1px solid #555555; border-radius:5px; }
QFrame#FormatBar QPushButton[formatButton="true"]:hover,
QFrame#FormatBar QPushButton[alignButton="true"]:hover,
QFrame#FormatBar QPushButton[menuButton="true"]:hover { background:#484848; border-color:#707070; }
QFrame#FormatBar QPushButton[formatButton="true"]:checked,
QFrame#FormatBar QPushButton[alignButton="true"]:checked { background:#1E3A5F; border-color:#3B82F6; }
QMenu#FormatBarMenu { background:#404040; color:#D8D8D8; border:1px solid #555555; border-radius:5px; padding:4px; }
QMenu#FormatBarMenu::item { background:transparent; color:#D8D8D8; padding:7px 22px 7px 10px; border-radius:3px; }
QMenu#FormatBarMenu::item:selected { background:#2563EB; color:#FFFFFF; }
QMenu#FormatBarMenu::separator { height:1px; background:#555555; margin:4px 6px; }
