/* ============================================================
   OpenPDF Studio — Dark Mode Stylesheet
   Base: #282828 charcoal gray
   ============================================================ */

/* ── Window & base ───────────────────────────────────────── */
QMainWindow {
    background-color: #1A1A1A;
}

QSplitter {
    background: #1A1A1A;
}

QSplitter::handle {
    background: #3A3A3A;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── TopToolbar ──────────────────────────────────────────── */
#TopToolbar {
    background-color: #282828;
    border-bottom: 1px solid #3A3A3A;
}

#AppLogo {
    background-color: #2563EB;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 800;
}

#AppNameLabel {
    color: #D0D0D0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.2px;
}

#DocTab {
    background-color: #333333;
    border: 1px solid #444444;
    border-radius: 6px;
}

#DocTabLabel {
    color: #BBBBBB;
    font-size: 13px;
    font-weight: 500;
}

#TabCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #666666;
    font-size: 14px;
    padding: 0px;
}

#TabCloseBtn:hover {
    background: #444444;
    color: #BBBBBB;
}

#NewTabBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #666666;
    font-size: 16px;
    font-weight: 400;
}

#NewTabBtn:hover {
    background: #333333;
    color: #BBBBBB;
}

#ZoomLabel {
    color: #D0D0D0;
    font-size: 13px;
    font-weight: 500;
    min-width: 44px;
    qproperty-alignment: AlignCenter;
}

/* ── IconButton ──────────────────────────────────────────── */
#IconButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0px;
}

#IconButton:hover {
    background-color: #383838;
}

#IconButton:pressed {
    background-color: #444444;
}

#IconButton:checked {
    background-color: #404040;
}

#IconButton:disabled {
    opacity: 0.4;
}

/* ── LeftSidebar ─────────────────────────────────────────── */
#LeftSidebar {
    background-color: #282828;
    border-right: 1px solid #3A3A3A;
}

#LeftSidebar #IconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
}

#LeftSidebar #IconButton:hover {
    background-color: #383838;
}

#LeftSidebar #IconButton:pressed {
    background-color: #444444;
}

#LeftSidebar #IconButton:checked {
    background-color: #404040;
}

/* ── DocumentView canvas ─────────────────────────────────── */
#DocumentView {
    background-color: #1A1A1A;
    border: none;
}

#DocumentCanvas {
    background-color: #1A1A1A;
}

#DocumentView QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:vertical {
    background: #484848;
    border-radius: 3px;
    min-height: 32px;
}

#DocumentView QScrollBar::handle:vertical:hover {
    background: #585858;
}

#DocumentView QScrollBar::add-line:vertical,
#DocumentView QScrollBar::sub-line:vertical { height: 0px; }

#DocumentView QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:horizontal {
    background: #484848;
    border-radius: 3px;
    min-width: 32px;
}

#DocumentView QScrollBar::handle:horizontal:hover {
    background: #585858;
}

#DocumentView QScrollBar::add-line:horizontal,
#DocumentView QScrollBar::sub-line:horizontal { width: 0px; }

/* ── RightSidebar ────────────────────────────────────────── */
#RightSidebar {
    background-color: #282828;
    border-left: 1px solid #3A3A3A;
}

#ModeButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    text-align: center;
}

#ModeButton:hover {
    background-color: #383838;
}

#ModeButtonSelected {
    background-color: #404040;
    border: 1px solid #505050;
    border-radius: 10px;
    text-align: center;
}

#ModeLabel {
    font-size: 11px;
    font-weight: 500;
    color: #666666;
}

#ModeLabelSelected {
    font-size: 11px;
    font-weight: 500;
    color: #C0C0C0;
}

/* ── StatusBar ───────────────────────────────────────────── */
#StatusBar {
    background-color: #282828;
    border-top: 1px solid #3A3A3A;
}

#PageInput {
    background: #333333;
    border: 1px solid #484848;
    border-radius: 5px;
    color: #D0D0D0;
    font-size: 13px;
    font-weight: 500;
    padding: 2px 4px;
    selection-background-color: #505050;
}

#PageInput:focus {
    border-color: #888888;
    outline: none;
}

#PageTotalLabel {
    color: #666666;
    font-size: 13px;
}

/* ── Generic QLabel ──────────────────────────────────────── */
QLabel {
    color: #D0D0D0;
}

/* ── Generic QPushButton fallback ────────────────────────── */
QPushButton {
    background-color: #484848;
    color: #E8E8E8;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 16px;
}

QPushButton:hover   { background-color: #585858; }
QPushButton:pressed { background-color: #383838; }
QPushButton:disabled { background-color: #333333; color: #666666; }

/* ── ScrollArea viewport ─────────────────────────────────── */
QScrollArea > QWidget > QWidget { background: transparent; }

/* ── SettingsPanel ───────────────────────────────────────── */
#SettingsPanel {
    background-color: #282828;
    border: 1px solid #444444;
    border-radius: 12px;
}
#SettingsPanelTitle {
    color: #D0D0D0;
    font-size: 13px;
    font-weight: 700;
}
#ThemeOptionBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #AAAAAA;
    font-size: 13px;
    text-align: left;
    padding: 8px 12px;
}
#ThemeOptionBtn:hover { background: #383838; }
#ThemeOptionBtn:checked {
    background: #404040;
    color: #E8E8E8;
    font-weight: 600;
}
