/* ============================================================
   OpenPDF Studio — Global Stylesheet
   ============================================================ */

/* ── Window & base ───────────────────────────────────────── */
QMainWindow {
    background-color: #F3F4F6;
}

QSplitter {
    background: #F3F4F6;
}

QSplitter::handle {
    background: #E5E7EB;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── TopToolbar ──────────────────────────────────────────── */
#TopToolbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

#AppLogo {
    background-color: #2563EB;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 800;
}

#AppNameLabel {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.2px;
}

#DocTab {
    background-color: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
}

#DocTabLabel {
    color: #374151;
    font-size: 13px;
    font-weight: 500;
}

#TabCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #9CA3AF;
    font-size: 14px;
    padding: 0px;
}

#TabCloseBtn:hover {
    background: #E5E7EB;
    color: #374151;
}

#NewTabBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #9CA3AF;
    font-size: 16px;
    font-weight: 400;
}

#NewTabBtn:hover {
    background: #F3F4F6;
    color: #374151;
}

#ZoomLabel {
    color: #111827;
    font-size: 13px;
    font-weight: 500;
    min-width: 44px;
    qproperty-alignment: AlignCenter;
}

/* ── IconButton (toolbar context) ────────────────────────── */
#IconButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    color: #374151;
    font-size: 14px;
    font-weight: 500;
    padding: 0px;
}

#IconButton:hover {
    background-color: #F3F4F6;
    color: #111827;
}

#IconButton:pressed {
    background-color: #E5E7EB;
    color: #111827;
}

#IconButton:checked {
    background-color: #EFF6FF;
    color: #2563EB;
}

#IconButton:disabled {
    color: #D1D5DB;
}

/* ── LeftSidebar ─────────────────────────────────────────── */
#LeftSidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

#LeftSidebar #IconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #6B7280;
    font-size: 15px;
}

#LeftSidebar #IconButton:hover {
    background-color: #F9FAFB;
    color: #111827;
}

#LeftSidebar #IconButton:pressed {
    background-color: #F3F4F6;
}

#LeftSidebar #IconButton:checked {
    background-color: #EFF6FF;
    color: #2563EB;
}

/* ── DocumentView canvas ─────────────────────────────────── */
#DocumentView {
    background-color: #F3F4F6;
    border: none;
}

#DocumentCanvas {
    background-color: #F3F4F6;
}

/* PDF page labels — always white paper */
QLabel#PageLabel {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
}

#DocumentView QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 3px;
    min-height: 32px;
}

#DocumentView QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

#DocumentView QScrollBar::add-line:vertical,
#DocumentView QScrollBar::sub-line:vertical { height: 0px; }

#DocumentView QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:horizontal {
    background: #D1D5DB;
    border-radius: 3px;
    min-width: 32px;
}

#DocumentView QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}

#DocumentView QScrollBar::add-line:horizontal,
#DocumentView QScrollBar::sub-line:horizontal { width: 0px; }

/* ── RightSidebar ────────────────────────────────────────── */
#RightSidebar {
    background-color: #FFFFFF;
    border-left: 1px solid #E5E7EB;
}

#ModeButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    text-align: center;
}

#ModeButton:hover {
    background-color: #F9FAFB;
}

#ModeButtonSelected {
    background-color: #F0F9FF;
    border: 1px solid #BAE6FD;
    border-radius: 10px;
    text-align: center;
}

#ModeIcon {
    font-size: 20px;
    color: #374151;
}

#ModeButtonSelected #ModeIcon {
    color: #2563EB;
}

#ModeLabel {
    font-size: 11px;
    font-weight: 500;
    color: #6B7280;
}

#ModeButtonSelected #ModeLabel {
    color: #1D4ED8;
}

/* ── StatusBar (page nav) ────────────────────────────────── */
#StatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

#PageInput {
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 5px;
    color: #111827;
    font-size: 13px;
    font-weight: 500;
    padding: 2px 4px;
    selection-background-color: #BFDBFE;
}

#PageInput:focus {
    border-color: #93C5FD;
    outline: none;
}

#PageTotalLabel {
    color: #6B7280;
    font-size: 13px;
}

#StatusBar #IconButton {
    color: #6B7280;
    font-size: 16px;
}

#StatusBar #IconButton:hover {
    background: #F3F4F6;
    color: #111827;
}

/* ── Generic QLabel ──────────────────────────────────────── */
QLabel {
    color: #111827;
}

/* ── Generic QPushButton fallback ────────────────────────── */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 16px;
}

QPushButton:hover  { background-color: #1D4ED8; }
QPushButton:pressed { background-color: #1E40AF; }
QPushButton:disabled { background-color: #E5E7EB; color: #9CA3AF; }

/* ── ScrollArea viewport ─────────────────────────────────── */
QScrollArea > QWidget > QWidget { background: transparent; }

/* ── SettingsPanel ───────────────────────────────────────── */
QDialog#SettingsPanel {
    background: #FFFFFF;
}

QWidget#SettingsSidebar {
    background: #F9FAFB;
    border-right: 1px solid #E5E7EB;
}

QStackedWidget#SettingsPages,
QScrollArea#SettingsScroll,
QWidget#SettingsScrollContent,
QWidget#SettingsAboutPage {
    background: #FFFFFF;
    border: none;
}

/* Override the global "transparent" scroll viewport rule */
QScrollArea#SettingsScroll > QWidget > QWidget {
    background: #FFFFFF;
}

QLabel#SettingsSectionTitle {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
}

QLabel#SettingsSectionDesc {
    font-size: 12px;
    color: #6B7280;
}

QFrame#SettingsSeparator {
    color: #E5E7EB;
    background: #E5E7EB;
    border: none;
    max-height: 1px;
}

QComboBox#SettingsLangCombo {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #111827;
}
QComboBox#SettingsLangCombo::drop-down { border: none; width: 20px; }
QComboBox#SettingsLangCombo QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    color: #111827;
}

QPushButton#SettingsSaveBtn {
    background: #2563EB;
    color: white;
    border: none;
}
QPushButton#SettingsSaveBtn:hover { background: #1D4ED8; }

QPushButton#SettingsResetBtn {
    background: transparent;
    color: #374151;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}
QPushButton#SettingsResetBtn:hover { background: #F3F4F6; }

QPushButton#SettingsCancelBtn {
    background: white;
    color: #374151;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}
QPushButton#SettingsCancelBtn:hover { background: #F3F4F6; }

/* ── Keyboard Shortcuts page ─────────────────────────────── */
QLineEdit#ShortcutSearch {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px 10px;
    background: #FFFFFF;
    color: #111827;
    font-size: 13px;
}

QWidget#ShortcutTableHeader {
    background: #F9FAFB;
}

QLabel#ShortcutColHeader {
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
}

QLabel#ShortcutDisplay {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 2px 12px;
    background: #F9FAFB;
    font-size: 13px;
    color: #374151;
}

QLineEdit#ShortcutCapture {
    border: 2px solid #3B82F6;
    border-radius: 6px;
    padding: 2px 10px;
    background: #FFFFFF;
    font-size: 13px;
    color: #111827;
}

QPushButton#ShortcutResetBtn {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: transparent;
    color: #6B7280;
    font-size: 15px;
}
QPushButton#ShortcutResetBtn:hover { background: #F3F4F6; color: #374151; }

QPushButton#ShortcutEditBtn {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: #FFFFFF;
    color: #374151;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#ShortcutEditBtn:hover { background: #F3F4F6; }

QPushButton#ShortcutSaveBtn {
    border: none;
    border-radius: 6px;
    background: #2563EB;
    color: white;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#ShortcutSaveBtn:hover { background: #1D4ED8; }

QPushButton#ShortcutCancelBtn {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: #FFFFFF;
    color: #374151;
    font-size: 12px;
}
QPushButton#ShortcutCancelBtn:hover { background: #F3F4F6; }

QPushButton#ShortcutClearBtn {
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    background: transparent;
    color: #6B7280;
    font-size: 11px;
}
QPushButton#ShortcutClearBtn:hover { background: #FEE2E2; color: #DC2626; border-color: #FCA5A5; }

QFrame#ShortcutInfoBar {
    background: #EFF6FF;
    border-top: 1px solid #BFDBFE;
}
QLabel#ShortcutInfoIcon { color: #2563EB; font-size: 14px; font-weight: 700; }
QLabel#ShortcutInfoText { color: #1D4ED8; font-size: 12px; }
