/* ============================================================
   OpenPDF Studio — Global Stylesheet
   ============================================================ */

/* ── Window & base ───────────────────────────────────────── */
QMainWindow {
    background-color: #F3F4F6;
}

QSplitter {
    background: #F3F4F6;
}

QSplitter::handle {
    background: #E5E7EB;
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical   { height: 1px; }

/* ── TopToolbar ──────────────────────────────────────────── */
#TopToolbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

#AppLogo {
    background-color: #2563EB;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 800;
}

#AppNameLabel {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.2px;
}

#DocTab {
    background-color: #F3F4F6;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
}

#DocTabLabel {
    color: #374151;
    font-size: 13px;
    font-weight: 500;
}

#TabCloseBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #9CA3AF;
    font-size: 14px;
    padding: 0px;
}

#TabCloseBtn:hover {
    background: #E5E7EB;
    color: #374151;
}

#NewTabBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #9CA3AF;
    font-size: 16px;
    font-weight: 400;
}

#NewTabBtn:hover {
    background: #F3F4F6;
    color: #374151;
}

#ZoomLabel {
    color: #111827;
    font-size: 13px;
    font-weight: 500;
    min-width: 44px;
    qproperty-alignment: AlignCenter;
}

/* ── IconButton (toolbar context) ────────────────────────── */
#IconButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    color: #374151;
    font-size: 14px;
    font-weight: 500;
    padding: 0px;
}

#IconButton:hover {
    background-color: #F3F4F6;
    color: #111827;
}

#IconButton:pressed {
    background-color: #E5E7EB;
    color: #111827;
}

#IconButton:checked {
    background-color: #EFF6FF;
    color: #2563EB;
}

#IconButton:disabled {
    color: #D1D5DB;
}

/* ── LeftSidebar ─────────────────────────────────────────── */
#LeftSidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5E7EB;
}

#LeftSidebar #IconButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #6B7280;
    font-size: 15px;
}

#LeftSidebar #IconButton:hover {
    background-color: #F9FAFB;
    color: #111827;
}

#LeftSidebar #IconButton:pressed {
    background-color: #F3F4F6;
}

#LeftSidebar #IconButton:checked {
    background-color: #EFF6FF;
    color: #2563EB;
}

/* ── Customize Tools card ────────────────────────────────── */
QFrame#ToolCustomizeCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}
QLabel#ToolCustomizeTitle {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
}
QLabel#ToolCustomizeHint {
    font-size: 12px;
    color: #9CA3AF;
    padding-top: 2px;
}
QPushButton#ToolCustomizeClose {
    border: none;
    background: transparent;
    border-radius: 5px;
}
QPushButton#ToolCustomizeClose:hover { background: #F3F4F6; }
QListWidget#ToolCustomizeList {
    background: transparent;
    border: none;
    outline: none;
}
QPushButton#ToolCustomizeReset {
    border: none;
    background: transparent;
    color: #2563EB;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 2px;
    text-align: left;
}
QPushButton#ToolCustomizeReset:hover { color: #1D4ED8; }

/* ── DocumentView canvas ─────────────────────────────────── */
#DocumentView {
    background-color: #F3F4F6;
    border: none;
}

#DocumentCanvas {
    background-color: #F3F4F6;
}

/* PDF page labels — always white paper */
QLabel#PageLabel {
    background: #FFFFFF;
    border: 1px solid #D1D5DB;
}

#DocumentView QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 3px;
    min-height: 32px;
}

#DocumentView QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

#DocumentView QScrollBar::add-line:vertical,
#DocumentView QScrollBar::sub-line:vertical { height: 0px; }

#DocumentView QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0px;
}

#DocumentView QScrollBar::handle:horizontal {
    background: #D1D5DB;
    border-radius: 3px;
    min-width: 32px;
}

#DocumentView QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}

#DocumentView QScrollBar::add-line:horizontal,
#DocumentView QScrollBar::sub-line:horizontal { width: 0px; }

/* ── Image region overlay ────────────────────────────────── */
QFrame#ImageRegionOverlay {
    border: 2px dashed #3B82F6;
    background: rgba(59, 130, 246, 15);
    border-radius: 3px;
}

/* ── Grid view ───────────────────────────────────────────── */
#GridCanvas {
    background: #F3F4F6;
}

QFrame#GridCard {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QFrame#GridCard:hover {
    border-color: #CBD5E1;
    background: #FAFAFA;
}

QLabel#GridPageLabel {
    font-size: 12px;
    font-weight: 500;
    color: #6B7280;
}

/* ── RightSidebar ────────────────────────────────────────── */
#RightSidebar {
    background-color: #FFFFFF;
    border-left: 1px solid #E5E7EB;
}

#ModeButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    text-align: center;
}

#ModeButton:hover {
    background-color: #F9FAFB;
}

#ModeButtonSelected {
    background-color: #F0F9FF;
    border: 1px solid #BAE6FD;
    border-radius: 10px;
    text-align: center;
}

#ModeIcon {
    font-size: 20px;
    color: #374151;
}

#ModeButtonSelected #ModeIcon {
    color: #2563EB;
}

#ModeLabel {
    font-size: 11px;
    font-weight: 500;
    color: #6B7280;
}

#ModeButtonSelected #ModeLabel {
    color: #1D4ED8;
}

/* ── StatusBar (page nav) ────────────────────────────────── */
#StatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E5E7EB;
}

#PageInput {
    background: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 5px;
    color: #111827;
    font-size: 13px;
    font-weight: 500;
    padding: 2px 4px;
    selection-background-color: #BFDBFE;
}

#PageInput:focus {
    border-color: #93C5FD;
    outline: none;
}

#PageTotalLabel {
    color: #6B7280;
    font-size: 13px;
}

#StatusBar #IconButton {
    color: #6B7280;
    font-size: 16px;
}

#StatusBar #IconButton:hover {
    background: #F3F4F6;
    color: #111827;
}

/* ── Generic QLabel ──────────────────────────────────────── */
QLabel {
    color: #111827;
}

/* ── Generic QPushButton fallback ────────────────────────── */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 16px;
}

QPushButton:hover  { background-color: #1D4ED8; }
QPushButton:pressed { background-color: #1E40AF; }
QPushButton:disabled { background-color: #E5E7EB; color: #9CA3AF; }

/* ── ScrollArea viewport ─────────────────────────────────── */
QScrollArea > QWidget > QWidget { background: transparent; }

/* ── SettingsPanel ───────────────────────────────────────── */
QDialog#SettingsPanel {
    background: #FFFFFF;
}

QWidget#SettingsSidebar {
    background: #F9FAFB;
    border-right: 1px solid #E5E7EB;
}

QStackedWidget#SettingsPages,
QScrollArea#SettingsScroll,
QWidget#SettingsScrollContent,
QWidget#SettingsAboutPage {
    background: #FFFFFF;
    border: none;
}

/* Override the global "transparent" scroll viewport rule */
QScrollArea#SettingsScroll > QWidget > QWidget {
    background: #FFFFFF;
}

QLabel#SettingsSectionTitle {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
}

QLabel#SettingsSectionDesc {
    font-size: 12px;
    color: #6B7280;
}

QLabel#SettingsGroupLabel {
    font-size: 11px;
    font-weight: 700;
    color: #6B7280;
}

QFrame#SettingsSeparator {
    color: #E5E7EB;
    background: #E5E7EB;
    border: none;
    max-height: 1px;
}

QComboBox#SettingsLangCombo {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 13px;
    color: #111827;
}
QComboBox#SettingsLangCombo::drop-down { border: none; width: 20px; }
QComboBox#SettingsLangCombo QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    color: #111827;
}

QPushButton#SettingsSaveBtn {
    background: #2563EB;
    color: white;
    border: none;
}
QPushButton#SettingsSaveBtn:hover { background: #1D4ED8; }

QPushButton#SettingsResetBtn {
    background: transparent;
    color: #374151;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}
QPushButton#SettingsResetBtn:hover { background: #F3F4F6; }

QPushButton#SettingsCancelBtn {
    background: white;
    color: #374151;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}
QPushButton#SettingsCancelBtn:hover { background: #F3F4F6; }

/* ── Keyboard Shortcuts page ─────────────────────────────── */
QLineEdit#ShortcutSearch {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px 10px;
    background: #FFFFFF;
    color: #111827;
    font-size: 13px;
}

QWidget#ShortcutTableHeader {
    background: #F9FAFB;
}

QLabel#ShortcutColHeader {
    font-size: 11px;
    font-weight: 600;
    color: #6B7280;
}

QLabel#ShortcutDisplay {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 2px 12px;
    background: #F9FAFB;
    font-size: 13px;
    color: #374151;
}

QLineEdit#ShortcutCapture {
    border: 2px solid #3B82F6;
    border-radius: 6px;
    padding: 2px 10px;
    background: #FFFFFF;
    font-size: 13px;
    color: #111827;
}

QPushButton#ShortcutResetBtn {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: transparent;
    color: #6B7280;
    font-size: 15px;
}
QPushButton#ShortcutResetBtn:hover { background: #F3F4F6; color: #374151; }

QPushButton#ShortcutEditBtn {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: #FFFFFF;
    color: #374151;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#ShortcutEditBtn:hover { background: #F3F4F6; }

QPushButton#ShortcutSaveBtn {
    border: none;
    border-radius: 6px;
    background: #2563EB;
    color: white;
    font-size: 12px;
    font-weight: 600;
}
QPushButton#ShortcutSaveBtn:hover { background: #1D4ED8; }

QPushButton#ShortcutCancelBtn {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: #FFFFFF;
    color: #374151;
    font-size: 12px;
}
QPushButton#ShortcutCancelBtn:hover { background: #F3F4F6; }

QPushButton#ShortcutClearBtn {
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    background: transparent;
    color: #6B7280;
    font-size: 11px;
}
QPushButton#ShortcutClearBtn:hover { background: #FEE2E2; color: #DC2626; border-color: #FCA5A5; }

QFrame#ShortcutInfoBar {
    background: #EFF6FF;
    border-top: 1px solid #BFDBFE;
}
QLabel#ShortcutInfoIcon { color: #2563EB; font-size: 14px; font-weight: 700; }
QLabel#ShortcutInfoText { color: #1D4ED8; font-size: 12px; }

QPushButton#SettingsActionBtn {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background: #FFFFFF;
    color: #374151;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 14px;
}
QPushButton#SettingsActionBtn:hover { background: #F3F4F6; }
QPushButton#SettingsActionBtn:disabled { color: #9CA3AF; background: #F9FAFB; }

/* ── Zoom settings page ───────────────────────────────────── */
QFrame#ZoomCard,
QFrame#SettingsCard {
    border: 1px solid #E5E7EB;
    border-radius: 10px;
    background: #FFFFFF;
}
QLabel#ZoomCardTitle,
QLabel#SettingsCardTitle {
    font-size: 13px;
    font-weight: 700;
    color: #111827;
}
QLabel#ZoomRowLabel,
QLabel#SettingsRowLabel {
    font-size: 13px;
    color: #111827;
}
QLabel#ZoomRowDesc,
QLabel#SettingsRowDesc {
    font-size: 12px;
    color: #6B7280;
}
QFrame#ZoomExampleBox {
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
}
QLabel#ZoomExampleIcon { color: #2563EB; font-size: 14px; }
QLabel#ZoomExampleText { font-size: 12px; color: #1D4ED8; }
QSpinBox#ZoomStepSpin {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 4px 8px;
    background: #FFFFFF;
    font-size: 13px;
    color: #111827;
}
QSpinBox#ZoomStepSpin::up-button, QSpinBox#ZoomStepSpin::down-button {
    width: 20px;
    border: none;
}
QComboBox#ZoomActionCombo,
QComboBox#AdvancedCombo,
QComboBox#UsageCombo {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 6px 10px;
    background: #FFFFFF;
    font-size: 13px;
    color: #111827;
    min-width: 120px;
}
QComboBox#ZoomActionCombo::drop-down,
QComboBox#AdvancedCombo::drop-down,
QComboBox#UsageCombo::drop-down { border: none; width: 20px; }
QComboBox#AdvancedCombo:disabled {
    color: #9CA3AF;
    background: #F9FAFB;
    border-color: #F3F4F6;
}
QFrame#TextPanel, QWidget#TextPanelContent, QScrollArea#TextPanelScroll {
    background: #FFFFFF;
    border: none;
}
QFrame#TextPanel { border-left: 1px solid #E2E8F0; }
QLabel#TextPanelTitle { color:#0F172A; font-size:16px; font-weight:700; padding-bottom:5px; }
QLabel#TextPanelHint { color:#64748B; font-size:12px; padding:6px 0 10px 0; }
QLabel[textSection="true"] { color:#0F172A; font-size:12px; font-weight:700; }
QFrame#TextPanelDivider { color:#E5EAF1; background:#E5EAF1; min-height:1px; max-height:1px; border:none; }
QPushButton#TextPanelClose { border:none; background:transparent; color:#64748B; font-size:18px; }
QPushButton#TextPanelClose:hover { color:#0F172A; background:#F1F5F9; border-radius:5px; }
QFrame#TextPanel QLabel { color:#334155; font-size:12px; }
QFrame#TextPanel QComboBox, QFrame#TextPanel QDoubleSpinBox {
    background:#FFFFFF; color:#0F172A; border:1px solid #CBD5E1; border-radius:5px;
    min-height:28px; padding:0 8px;
}
QFrame#TextPanel QComboBox:focus, QFrame#TextPanel QDoubleSpinBox:focus { border:1px solid #3B82F6; }
QFrame#TextPanel QComboBox:hover, QFrame#TextPanel QDoubleSpinBox:hover { border-color:#94A3B8; }
QFrame#TextPanel QComboBox:disabled, QFrame#TextPanel QDoubleSpinBox:disabled { background:#F8FAFC; color:#94A3B8; border-color:#E2E8F0; }
QFrame#TextPanel QComboBox::drop-down { border:none; width:24px; }
QPushButton[switch="true"] { background:#CBD5E1; color:#FFFFFF; border:none; border-radius:10px; padding:0 3px; text-align:left; }
QPushButton[switch="true"]:checked { background:#3B82F6; text-align:right; }
QPushButton[switch="true"]::indicator { width:0; height:0; }
QPushButton#TextPanelSaveDefault { color:#2563EB; background:#FFFFFF; border:1px solid #CBD5E1; border-radius:6px; font-weight:600; }
QPushButton#TextPanelSaveDefault:hover { background:#EFF6FF; border-color:#60A5FA; }
QFrame#TextPanel QSlider::groove:horizontal { height:3px; background:#CBD5E1; border-radius:1px; }
QFrame#TextPanel QSlider::sub-page:horizontal { background:#3B82F6; }
QFrame#TextPanel QSlider::handle:horizontal { background:#3B82F6; width:14px; height:14px; margin:-6px 0; border-radius:7px; }

/* ── Text FormatBar ─────────────────────────────────────── */
QFrame#FormatBar { background:#FFFFFF; border-bottom:1px solid #E5E7EB; }
QFrame#FormatBar QLabel[formatLabel="true"] { color:#9CA3AF; font-size:9px; font-weight:600; padding-bottom:1px; }
QFrame#FormatBar QFrame#FormatBarSeparator { background:#E5E7EB; border:none; }
QFrame#FormatBar QComboBox#FormatBarCombo,
QFrame#FormatBar QFontComboBox#FormatBarCombo {
    background:#FFFFFF; color:#111827; border:1px solid #D1D5DB;
    border-radius:6px; padding-left:8px;
}
QFrame#FormatBar QComboBox#FormatBarCombo:hover,
QFrame#FormatBar QFontComboBox#FormatBarCombo:hover { border-color:#9CA3AF; }
QFrame#FormatBar QComboBox#FormatBarCombo:focus,
QFrame#FormatBar QFontComboBox#FormatBarCombo:focus { border-color:#3B82F6; }
QFrame#FormatBar QComboBox#FormatBarCombo::drop-down,
QFrame#FormatBar QFontComboBox#FormatBarCombo::drop-down { border-left:1px solid #E5E7EB; width:24px; }
QFrame#FormatBar QComboBox#FormatBarCombo::down-arrow,
QFrame#FormatBar QFontComboBox#FormatBarCombo::down-arrow { image:url(:/icons/chevron-down.svg); width:11px; height:11px; }
QFrame#FormatBar QComboBox#FormatBarCombo QLineEdit { background:#FFFFFF; color:#111827; border:none; }
QFrame#FormatBar QPushButton[formatButton="true"] {
    background:#FFFFFF; color:#374151; border:1px solid #D1D5DB; border-radius:5px;
}
QFrame#FormatBar QPushButton[alignButton="true"] { background:transparent; border:none; border-radius:5px; }
QFrame#FormatBar QPushButton[menuButton="true"] { background:#FFFFFF; color:#374151; border:1px solid #D1D5DB; border-radius:5px; }
QFrame#FormatBar QPushButton[formatButton="true"]:hover,
QFrame#FormatBar QPushButton[alignButton="true"]:hover,
QFrame#FormatBar QPushButton[menuButton="true"]:hover { background:#F3F4F6; border-color:#9CA3AF; }
QFrame#FormatBar QPushButton[formatButton="true"]:checked,
QFrame#FormatBar QPushButton[alignButton="true"]:checked { background:#EFF6FF; border-color:#BFDBFE; }
QMenu#FormatBarMenu {
    background:#FFFFFF; color:#1F2937; border:1px solid #D1D5DB;
    border-radius:5px; padding:4px;
}
QMenu#FormatBarMenu::item { background:transparent; color:#1F2937; padding:7px 22px 7px 10px; border-radius:3px; }
QMenu#FormatBarMenu::item:selected { background:#EFF6FF; color:#1D4ED8; }
QMenu#FormatBarMenu::separator { height:1px; background:#E5E7EB; margin:4px 6px; }
