        <file>i18n/openpdf_es.qm</file>
        <file>i18n/openpdf_it.qm</file>
        <file>i18n/openpdf_pt.qm</file>
        <file>i18n/openpdf_nl.qm</file>
        <file>i18n/openpdf_pl.qm</file>
