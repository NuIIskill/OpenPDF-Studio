        <file>i18n/openpdf_ja.qm</file>
        <file>i18n/openpdf_ko.qm</file>
    </qresource>
    <qresource prefix="/theme">
        <file alias="Style.qss">../src/ui/theme/Style.qss</file>
        <file alias="Style.dark.qss">../src/ui/theme/Style.dark.qss</file>
    </qresource>
    <qresource prefix="/">
        <file>icons/mouse-pointer-2.svg</file>
