#include <winver.h>

IDI_ICON1 ICON "openpdf-studio.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "nullskill"
            VALUE "FileDescription",  "OpenPDF Studio"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "OpenPDFStudio"
            VALUE "LegalCopyright",   "\xA9 nullskill"
            VALUE "OriginalFilename", "OpenPDFStudio.exe"
            VALUE "ProductName",      "OpenPDF Studio"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
